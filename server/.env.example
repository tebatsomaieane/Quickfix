# QuickFix server environment variables
# Copy this file to .env and fill in real values.

# ──────────────────────────────────────────────
# MySQL connection
# ──────────────────────────────────────────────
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=quickfix
DB_PORT=3306

# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
PORT=5000

# development | production | test
NODE_ENV=development

# Comma-separated list of allowed origins (production must be set to your domains).
# Example: CLIENT_ORIGIN=https://app.quickfix.example,https://admin.quickfix.example
CLIENT_ORIGIN=http://localhost:5173

# Session cookie SameSite policy: "lax" (default) for same-origin setups.
# When the frontend is hosted on a DIFFERENT origin (e.g. Cloudflare Pages)
# browsers require "none" so the cookie is sent on cross-site requests.
# COOKIE_SAMESITE=none

# Use a long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret

# ──────────────────────────────────────────────
# Optional
# ──────────────────────────────────────────────

# Log format for morgan: combined | dev | short | tiny
LOG_FORMAT=combined

# Absolute base URL used when building public URLs for uploaded media.
# Example: PUBLIC_API_URL=https://api.quickfix.co.ls
# When unset, the server derives it from the incoming request.
# PUBLIC_API_URL=https://api.quickfix.co.ls

# Public app origin used to build email links (password reset).
# Defaults to CLIENT_ORIGIN.
PUBLIC_APP_URL=http://localhost:5173

# ──────────────────────────────────────────────
# Email (SMTP) — required in production so password
# reset links actually reach users.
# ──────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=QuickFix <no-reply@quickfix.co.ls>

# Whether the rate limiter exempts loopback (localhost) requests.
# Defaults to exempt in development, enforced in production.
# RATE_LIMIT_SKIP_LOOPBACK=false

# Upload policy. Daily quota is per user per 24h period (MB).
UPLOAD_DAILY_QUOTA_MB=250

# How long an uploaded file may sit unreferenced before the cleanup job
# deletes it (minutes). Gives users time to finish a draft/save a profile.
UPLOAD_ORPHAN_MINUTES=1440

# How often the orphan cleanup job runs (minutes, 0 disables).
UPLOAD_CLEANUP_MINUTES=360