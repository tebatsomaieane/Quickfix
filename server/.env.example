# QuickFix server environment variables
# Copy this file to .env and fill in real values.

# ──────────────────────────────────────────────
# MySQL connection
# ──────────────────────────────────────────────
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=quickfix
DB_PORT=3306

# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
PORT=5000

# development | production | test
NODE_ENV=development

# Comma-separated list of allowed origins (production must be set to your domains).
# Example: CLIENT_ORIGIN=https://app.quickfix.example,https://admin.quickfix.example
CLIENT_ORIGIN=http://localhost:5173

# Use a long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret

# ──────────────────────────────────────────────
# Optional
# ──────────────────────────────────────────────

# Log format for morgan: combined | dev | short | tiny
LOG_FORMAT=combined

# Demo-only: echo password-reset tokens in the API response.
# Must NEVER be true in production. Set to false (or remove).
RETURN_RESET_TOKEN=false

# Whether the rate limiter exempts loopback (localhost) requests.
# Defaults to exempt in development, enforced in production.
# RATE_LIMIT_SKIP_LOOPBACK=false