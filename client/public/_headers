# Cloudflare Pages security headers.
#
# connect-src / img-src / media-src name *.up.railway.app so the split
# deployment (app on Pages, API on Railway) is not blocked by the policy.
# If the API ever moves to its own custom domain, add that host to those
# three directives -- a deploy whose API origin is missing here fails
# silently in the browser console while everything else looks healthy.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://thumb.wikimedia.org https://*.up.railway.app; media-src 'self' blob: https://*.up.railway.app; connect-src 'self' https://*.up.railway.app; manifest-src 'self'; worker-src 'self' blob:; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests'

# The React shell must never be cached, or a deploy leaves browsers running
# stale asset references that no longer exist on Pages.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex

# Fingerprinted bundles are content-addressed by Vite, so they can be cached
# for the full max-age with no revalidation cost.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
