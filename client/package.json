{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "check:menu": "node scripts/check-mobile-menu.mjs",
    "check:a11y": "node scripts/check-form-a11y.mjs",
    "check:titles": "node scripts/check-route-titles.mjs",
    "check:connection": "node scripts/check-connection-banner.mjs",
    "check:format": "node scripts/check-format.mjs",
    "check:validation": "node scripts/check-validation.mjs",
    "check:apicache": "node scripts/check-api-cache.mjs",
    "check:errors": "node scripts/check-error-messages.mjs",
    "check:feedback": "node scripts/check-action-feedback.mjs",
    "check:deploy": "node scripts/check-deploy-config.mjs",
    "verify:pages": "node scripts/verify-pages-build.mjs",
    "check": "npm run lint && npm run check:menu && npm run check:a11y && npm run check:titles && npm run check:connection && npm run check:format && npm run check:validation && npm run check:apicache && npm run check:errors && npm run check:feedback && npm run check:deploy",
    "preview": "vite preview",
    "deploy": "npm run build && cd .. && vercel --prod --yes",
    "deploy:preview": "npm run build && cd .. && vercel --yes",
    "deploy:cloudflare": "npm run build && npm run verify:pages && wrangler pages deploy dist --project-name quickfix --commit-dirty=true",
    "deploy:cloudflare:preview": "npm run build && npm run verify:pages && wrangler pages deploy dist --project-name quickfix --branch preview --commit-dirty=true"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "esbuild": "^0.28.1",
    "globals": "^17.11.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "wrangler": "^4.133.0"
  }
}
