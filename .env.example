# ──────────────────────────────────────────────
# Docker Compose environment variables
# Copy this file to .env and fill in real values.
# ──────────────────────────────────────────────

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_USER=quickfix_user
DB_PASSWORD=change_me_db_password
DB_NAME=quickfix
MYSQL_PORT=3306

# API server (REQUIRED — random long string).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret

# CORS origin(s) that may call the API (comma-separated).
# When the frontend is on Cloudflare Pages, add its domain:
#   CLIENT_ORIGIN=https://quickfix.pages.dev,https://quickfix.co.ls
CLIENT_ORIGIN=http://localhost

# Cross-site cookies: browsers drop the session cookie unless it is
# SameSite=None when the app and API are on different origins.
# Force to "none" when deploying the frontend on Cloudflare Pages:
#   COOKIE_SAMESITE=none
# (leave as lax for the default same-origin compose setup)
# COOKIE_SAMESITE=none

# Public base used when building uploaded-media URLs. Required when the
# API is behind a proxy or accessed from another origin.
# PUBLIC_API_URL=https://api.quickfix.co.ls
#
# The Content-Security-Policy below reads API_ORIGIN / PUBLIC_ORIGIN. The
# API falls back to PUBLIC_API_URL for API_ORIGIN, so setting PUBLIC_API_URL
# alone is enough -- but the split values are preferred when you want the
# policy to be explicit:
#   API_ORIGIN=https://api.quickfix.co.ls     API's own public address
#   PUBLIC_ORIGIN=https://quickfix.co.ls      address the built app is on
# If neither is set the policy allows same-origin only, which blocks API
# calls and uploaded media when the frontend is on a different origin.
#   API_ORIGIN=https://api.quickfix.co.ls
#   PUBLIC_ORIGIN=https://quickfix.co.ls

# Origin used in password-reset email links (defaults to CLIENT_ORIGIN).
# On Cloudflare Pages set this to the frontend domain.
# PUBLIC_APP_URL=https://quickfix.co.ls

# Public port for the web app (nginx).
CLIENT_PORT=80

# ──────────────────────────────────────────────
# VPS deployment (deploy/docker-compose.prod.yml + Caddy HTTPS)
# ──────────────────────────────────────────────
# Hostname whose DNS A record points at this server (REQUIRED there).
# DOMAIN=quickfix.example.com
# ACME_EMAIL=admin@example.com
# For a same-origin VPS deployment also set:
#   CLIENT_ORIGIN=https://<DOMAIN>
#   PUBLIC_APP_URL=https://<DOMAIN>

# Client build args
VITE_API_URL=/api

# morgan log format
LOG_FORMAT=combined

# ──────────────────────────────────────────────
# Email (SMTP) — for verification PINs, login 2FA codes
# and password resets. Leave empty to run without email
# (codes are then printed to the server console).
# ──────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=QuickFix <no-reply@quickfix.co.ls>

# Require email verification (6-digit PIN) before login.
REQUIRE_EMAIL_VERIFICATION=false