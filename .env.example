# ──────────────────────────────────────────────
# Docker Compose environment variables
# Copy this file to .env and fill in real values.
# ──────────────────────────────────────────────

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_USER=quickfix_user
DB_PASSWORD=change_me_db_password
DB_NAME=quickfix
MYSQL_PORT=3306

# API server (REQUIRED — random long string).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret

# CORS origin(s) that may call the API (comma-separated).
# In the default compose setup the app is same-origin, so this is only
# needed if you call the API directly from another domain.
CLIENT_ORIGIN=http://localhost

# Public port for the web app (nginx).
CLIENT_PORT=80

# Client build args
VITE_API_URL=/api

# morgan log format
LOG_FORMAT=combined